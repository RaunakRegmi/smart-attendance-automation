{
  "name": "student-attendance-system",
  "version": "1.0.0",
  "description": "Student Attendance Management System with Excel upload/export",
  "main": "index.js",
  "scripts": {
    "worker": "node src/workers/sheetSyncWorker.js",
    "start": "node src/index.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js src/index.js",
    "seed": "node src/utils/seedData.js",
    "backfill:qr": "node src/utils/backfillQrAttendance.js",
    "migrate": "npx sequelize-cli db:migrate",
    "test": "jest --runInBand --coverage",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:int": "jest --runInBand --selectProjects int",
    "test:e2e": "jest --runInBand --selectProjects e2e"
  },
  "keywords": [
    "attendance",
    "students",
    "management",
    "excel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.0.0"
  }
}
