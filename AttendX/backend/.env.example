NODE_ENV=development
PORT=5000

# Local dev (npm run dev on host)
DB_HOST=localhost
DB_PORT=5432

# Docker Compose overrides DB_HOST=db and REDIS_HOST=redis automatically
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=admin

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5000000
ALLOWED_EXTENSIONS=xlsx,xls

JWT_SECRET=your_jwt_secret_change_in_production
REDIS_HOST=localhost
REDIS_PORT=6379

# Set true only for local quick schema sync without migrations (not used in Docker)
DB_SYNC_ALTER=false

# ── Teacher credential delivery (email / SMS) ────────────────────────────────
# Base URL used in delivered login/reset links (the admin+teacher web app)
APP_BASE_URL=http://localhost:4200
# Reset-token lifetime in hours (single-use links)
RESET_TOKEN_TTL_HOURS=48

# Email: demo = log to console (no credentials needed) | smtp = real send
MAIL_PROVIDER=demo
MAIL_FROM=AttendX <no-reply@attendx.local>
# SMTP settings (only needed when MAIL_PROVIDER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# SMS: demo = validate + log to console | sparrow = future real integration
SMS_PROVIDER=demo
# Sparrow SMS (future — drop-in behind the same smsService interface)
# SPARROW_SMS_TOKEN=
# SPARROW_SMS_FROM=
# SPARROW_SMS_BASE_URL=https://api.sparrowsms.com/v2/sms/

# Set true in tests/CI to skip the scheduler and BullMQ workers (no Redis needed)
# DISABLE_BACKGROUND_JOBS=true
